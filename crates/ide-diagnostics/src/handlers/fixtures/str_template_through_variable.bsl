Процедура ШаблонВПеременной(Номер, Дата, Суффикс)
    Шаблон = "Документ %1" + " от %2";
    Текст = СтрШаблон(Шаблон, Номер, Дата);
    ШаблонСтроки = НСтр("ru = 'Строка %1'") + Символы.ПС + "Итог %2";
    Текст = СтрШаблон(ШаблонСтроки, Номер, Дата);
    Начало = "Документ %1";
    ШаблонИзЧастей = Начало + " от %2";
    Текст = СтрШаблон(ШаблонИзЧастей + ".", Номер, Дата);
    ШаблонССуффиксом = "Документ %1" + Суффикс;
    Текст = СтрШаблон(ШаблонССуффиксом, Номер, Дата);
КонецПроцедуры

Процедура ШаблонИзПараметра(ШаблонПараметр, Номер)
    Если Номер = 0 Тогда
        ШаблонПараметр = "Без номера";
    КонецЕсли;
    Текст = СтрШаблон(ШаблонПараметр, Номер);
КонецПроцедуры

Процедура ОшибкиВШаблонеИзПеременной(Номер, Дата)
    Шаблон = "Документ %1" + " от %2";
    Текст = СтрШаблон(Шаблон, Номер);
    ШаблонБезДаты = НСтр("ru = 'Документ %1'") + " без даты";
    Текст = СтрШаблон(ШаблонБезДаты, Номер, Дата);
    Начало = "Документ %1";
    ШаблонИзЧастей = Начало + " от %2";
    Текст = СтрШаблон(ШаблонИзЧастей + ".", Номер);
    ШаблонПеревода = НСтр("ru = 'Документ %1'; en = 'Document'");
    Текст = СтрШаблон(ШаблонПеревода, Номер);
КонецПроцедуры
