Процедура ПереводыВШаблоне(Номер, Дата)
    Текст = СтрШаблон(НСтр("ru = 'Документ %1 от %2'; en = 'Document %1 of %2'"), Номер, Дата);
    Текст = СтрШаблон(НСтр("ru = 'Документ %1'; en = 'Document %1'") + " (%2)", Номер, Дата);
    Текст = СтрШаблон(НСтр("ru = 'Документ %1';
        |en = 'Document %1'"), Номер);
    Текст = СтрШаблон(НСтр("ru = 'Документ %1 от %2'; en = 'Document %1'", "ru"), Номер, Дата);
    Текст = СтрШаблон(НСтр("Документ %1"), Номер);
КонецПроцедуры

Процедура ОшибкиВПереводахШаблона(Номер, Дата, КодЯзыка)
    Текст = СтрШаблон(НСтр("ru = 'Документ %1 от %2'; en = 'Document %1'"), Номер, Дата);
    Текст = СтрШаблон(НСтр("ru = 'Документ %1'; en = 'Document'"), Номер);
    Текст = СтрШаблон(НСтр("ru = 'Документ'; en = 'Document %1'", "ru") + " %2", Номер, Дата);
    Текст = СтрШаблон(НСтр("ru = 'Документ %1'; en = 'Document %1 of %2'", КодЯзыка), Номер);
КонецПроцедуры
