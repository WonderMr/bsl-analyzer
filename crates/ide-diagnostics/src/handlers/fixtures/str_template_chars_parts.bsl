Процедура СимволыВШаблоне(Вид, Код, Количество, Настройки)
    Текст = СтрШаблон("Вид: %1" + Символы.ПС + "Код: %2", Вид, Код);
    Текст = СтрШаблон("Вид: %1" + Chars.LF + "Код: %2", Вид, Код);
    Текст = СтрШаблон("Записей: %1" + Символы.ВК + Символы.ПС + "Итого: %2", Количество, Код);
    Текст = СтрШаблон(Символы.Таб + "%1" + Символы.ВТаб + "%2" + Символы.ПФ + Символы.НПП, Вид, Код);
    Текст = СтрШаблон("Вид: %1" + Символы.Прочее + "Код: %2", Вид);
    Текст = СтрШаблон("Вид: %1" + Настройки.ПС + "Код: %2", Вид);
КонецПроцедуры

Процедура ОшибкиССимволамиВШаблоне(Вид, Код, Количество)
    Текст = СтрШаблон("Вид: %1" + Символы.ПС + "Код: %2", Вид);
    Текст = СтрШаблон("Вид" + Символы.ПС + "Код", Вид);
    Текст = СтрШаблон("Вид: %1" + Chars.Tab + "Код: %2", Вид, Код, Количество);
КонецПроцедуры
