Процедура ЗаписатьОшибку(ТекстОшибки, СсылкаНаОбъект = Неопределено)
    МетаданныеОбъекта = Неопределено;
    Если Неопределено <> СсылкаНаОбъект Тогда
        Попытка
            МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
        Исключение
            // Не ссылка: событие пишется без объекта метаданных.
            МетаданныеОбъекта = Неопределено;
        КонецПопытки;
    КонецЕсли;
    ЗаписьЖурналаРегистрации(
        "Интеграция.Ошибка",
        УровеньЖурналаРегистрации.Ошибка,
        МетаданныеОбъекта,
        СсылкаНаОбъект,
        ТекстОшибки
    );
    ЗаписьЖурналаРегистрации(
        "Интеграция.ОшибкаЛоггера",
        УровеньЖурналаРегистрации.Ошибка,
        Неопределено,
        Неопределено,
        ТекстОшибки);
    ЗаписьЖурналаРегистрации("Интеграция.Итоги", УровеньЖурналаРегистрации.Информация, , , ТекстОшибки);
КонецПроцедуры

Процедура ЗаписатьСобытиеСЧисломВместоМетаданных(ТекстОшибки)
    ЗаписьЖурналаРегистрации("Интеграция.Ошибка", УровеньЖурналаРегистрации.Ошибка, 5, , ТекстОшибки);
КонецПроцедуры
