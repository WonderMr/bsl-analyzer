Процедура ЗаписатьСобытие(Текст, Значение = Неопределено)
    МетаОбъект = Неопределено;
    Если Неопределено <> Значение Тогда
        Попытка
            МетаОбъект = Значение.Метаданные();
        Исключение
            МетаОбъект = Неопределено;
        КонецПопытки;
    КонецЕсли;
    ЗаписьЖурналаРегистрации(
        "Тест.Ошибка",
        УровеньЖурналаРегистрации.Ошибка,
        МетаОбъект,
        Значение,
        Текст
    );
    ЗаписьЖурналаРегистрации(
        "Тест.Предупреждение",
        УровеньЖурналаРегистрации.Предупреждение,
        Неопределено,
        Неопределено,
        Текст);
    ЗаписьЖурналаРегистрации("Тест.Информация", УровеньЖурналаРегистрации.Информация, , , Текст);
КонецПроцедуры

Процедура ЗаписатьСобытиеСЧислом(Текст)
    ЗаписьЖурналаРегистрации("Тест.Ошибка", УровеньЖурналаРегистрации.Ошибка, 5, , Текст);
КонецПроцедуры
