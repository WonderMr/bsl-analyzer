Процедура ШаблонИзЛитералов(Запись, ТипОбъекта, Идентификатор, Количество, Имена, Контур)
    ЗаписьЖурналаРегистрации("Событие", УровеньЖурналаРегистрации.Предупреждение, , Запись,
        СтрШаблон("Проводка уходит без даты "
            + "(по текущему курсу): Дт %1 / Кт %2, сумма %3, актив %4. Нужна дата "
            + "признания актива.",
            Запись.СчетДт, Запись.СчетКт, Запись.Сумма, Запись.Актив));
    Текст = СтрШаблон("Неизвестный тип объекта"
        + Символы.ПС + "Тип: %1"
        + Символы.ПС + "Идентификатор: %2",
            ТипОбъекта, Идентификатор);
    Текст = СтрШаблон(
        "Отложено документов: %1 - справочники ещё не подтверждены как"
        + " доставленные: %2. Отправка повторится следующим прогоном.",
        Количество,
        СтрСоединить(Имена, ", "));
    Текст = СтрШаблон(
        "Отправка остановлена: выбран контур «%1», но база не опознана как"
        + " рабочая (ИБ ""%2"", рабочая - ""%3"").",
            Контур, ИмяБазы(), ИмяРабочейБазы());
    Текст = СтрШаблон("Дозарегистрировано справочников: %1."
        + " Они не попали в очередь подпиской.%2%3",
            Количество, Символы.ПС, СтрСоединить(Имена, Символы.ПС));
    Текст = СтрШаблон(НСтр("ru = 'Документ %1'") + " (%2)", Запись.Номер, Запись.Дата);
    Текст = СтрШаблон("Документ №" + Запись.Номер, Запись.Дата);
КонецПроцедуры

Процедура ОшибкиВШаблонеИзЛитералов(Номер, Дата)
    Текст = СтрШаблон("Документ №%1" + " от %2", Номер);
    Текст = СтрШаблон("Документ без подстановок" + " и без даты", Номер);
    Текст = СтрШаблон("Документ №%1" + " от %2", Номер, Дата, Номер);
    Текст = СтрШаблон(НСтр("ru = 'Документ %1'") + " (%2)", Номер);
КонецПроцедуры
