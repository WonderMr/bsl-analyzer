Процедура ШаблонИзЛитералов(Запись, Вид, Код, Количество, Имена, Значение)
    ЗаписьЖурналаРегистрации("Событие", УровеньЖурналаРегистрации.Предупреждение, , Запись,
        СтрШаблон("Запись %1 обработана "
            + "с замечаниями: поле %2, значение %3, автор %4. Повторная "
            + "проверка не требуется.",
            Запись.Номер, Запись.Поле, Запись.Значение, Запись.Автор));
    Текст = СтрШаблон("Неизвестный вид записи"
        + Символы.ПС + "Вид: %1"
        + Символы.ПС + "Код: %2",
            Вид, Код);
    Текст = СтрШаблон(
        "Пропущено строк: %1 - значения ещё не проверены как"
        + " допустимые: %2. Проверка повторится позже.",
        Количество,
        СтрСоединить(Имена, ", "));
    Текст = СтрШаблон(
        "Значение «%1» не найдено в справочнике"
        + " (имя ""%2"", ожидалось ""%3"").",
            Значение, ПолучитьИмя(), ПолучитьОжидаемоеИмя());
    Текст = СтрШаблон("Добавлено элементов: %1."
        + " Список обновлён.%2%3",
            Количество, Символы.ПС, СтрСоединить(Имена, Символы.ПС));
    Текст = СтрШаблон(НСтр("ru = 'Документ %1'") + " (%2)", Запись.Номер, Запись.Дата);
    Текст = СтрШаблон("Документ №" + Запись.Номер, Запись.Дата);
    Текст = СтрШаблон("Документ %1
        |от %2", Запись.Номер, Запись.Дата);
    Текст = СтрШаблон(("Документ %1" + " от %2"), Запись.Номер, Запись.Дата);
КонецПроцедуры

Процедура ОшибкиВШаблонеИзЛитералов(Номер, Дата)
    Текст = СтрШаблон("Документ №%1" + " от %2", Номер);
    Текст = СтрШаблон("Документ без подстановок" + " и без даты", Номер);
    Текст = СтрШаблон("Документ №%1" + " от %2", Номер, Дата, Номер);
    Текст = СтрШаблон(НСтр("ru = 'Документ %1'") + " (%2)", Номер);
    Текст = СтрШаблон("Документ %1
        |от %2", Номер);
    Текст = СтрШаблон(("Документ %1" + " от %2"), Номер);
КонецПроцедуры
