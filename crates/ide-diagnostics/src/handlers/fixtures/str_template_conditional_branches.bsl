Процедура ВетвиУсловияВШаблоне(ЕстьДата, Номер, Дата, ТекстШаблона)
    Текст = СтрШаблон(?(ЕстьДата, "Документ %1 от %2", "Документ %1 (%2)"), Номер, Дата);
    Текст = СтрШаблон("Документ %1" + ?(ЕстьДата, " от %2", " (%2)"), Номер, Дата);
    Текст = СтрШаблон(?(ЕстьДата,
        НСтр("ru = 'Документ %1 от %2'"),
        НСтр("ru = 'Документ %1 (%2)'")), Номер, Дата);
    Текст = СтрШаблон(?(ЕстьДата, "Документ %1 от %2", ТекстШаблона), Номер);
КонецПроцедуры

Процедура ОшибкиВВетвяхУсловия(ЕстьДата, Номер)
    Текст = СтрШаблон(?(ЕстьДата, "Документ %1 от %2", "Документ %1"), Номер);
    Текст = СтрШаблон(?(ЕстьДата, "Документ %1", "Документ"), Номер);
    Текст = СтрШаблон("Документ %1" + ?(ЕстьДата, " от %2", ""), Номер);
КонецПроцедуры
